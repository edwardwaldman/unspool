{"dur": 27.26, "lines": [{"shot": "omg", "text": "Ohhh.", "ws": [0.13], "s": 0.13, "e": 2.75}, {"shot": "firstday", "text": "My first day at Unspool support,", "ws": [2.89, 3.122, 3.39, 3.515, 3.658, 4.015], "s": 2.89, "e": 4.568}, {"shot": "msg", "text": "a student messaged, \"My bio test is tomorrow and my notes are 40 pages.\"", "ws": [4.658, 4.765, 5.051, 5.569, 5.783, 6.033, 6.229, 6.372, 6.89, 7.015, 7.14, 7.354, 7.551, 7.926], "s": 4.658, "e": 8.399}, {"shot": "onereel", "text": "I said, \"No tension. I am making you one reel.\"", "ws": [8.489, 8.578, 8.846, 9.042, 9.578, 9.649, 9.774, 10.078, 10.292, 10.507], "s": 8.489, "e": 10.774}, {"shot": "slipped", "text": "My finger slipped.", "ws": [10.864, 11.025, 11.31], "s": 10.864, "e": 11.641}, {"shot": "textbook", "text": "I turned her whole textbook into reels, 400 pages, 38 reels.", "ws": [11.731, 11.838, 12.052, 12.302, 12.552, 12.909, 13.106, 13.677, 13.999, 14.649, 14.972], "s": 11.731, "e": 15.356}, {"shot": "aiyo", "text": "Aiyooo.", "ws": [15.446], "s": 15.446, "e": 16.062}, {"shot": "onereel2", "text": "She watched one reel. Okay, one reel only.", "ws": [16.152, 16.294, 16.598, 16.812, 17.143, 17.5, 17.696, 17.857], "s": 16.152, "e": 18.214}, {"shot": "quiz", "text": "Then she did the quiz, full marks.", "ws": [18.304, 18.5, 18.625, 18.768, 18.911, 19.214, 19.429], "s": 18.304, "e": 19.813}, {"shot": "spread", "text": "Then her friend watched, then the whole class, then the whole school!", "ws": [19.903, 20.046, 20.242, 20.51, 20.921, 21.064, 21.224, 21.492, 21.992, 22.117, 22.242, 22.51], "s": 19.903, "e": 23.073}, {"shot": "city", "text": "Too late! the whole city is scrolling biology.", "ws": [23.163, 23.306, 23.726, 23.904, 24.226, 24.476, 24.601, 24.922], "s": 23.163, "e": 25.449}]}