{"dur": 25.79, "lines": [{"shot": "omg", "text": "Ohhh.", "ws": [0.13], "s": 0.13, "e": 1.283}, {"shot": "firstday", "text": "My first day at Unspool support,", "ws": [1.423, 1.655, 1.923, 2.048, 2.191, 2.548], "s": 1.423, "e": 3.101}, {"shot": "msg", "text": "a student messaged, \"My bio test is tomorrow and my notes are 40 pages.\"", "ws": [3.191, 3.298, 3.584, 4.102, 4.316, 4.566, 4.762, 4.905, 5.423, 5.548, 5.673, 5.887, 6.084, 6.459], "s": 3.191, "e": 6.932}, {"shot": "onereel", "text": "I said, \"No tension. I am making you one reel.\"", "ws": [7.022, 7.111, 7.379, 7.575, 8.111, 8.182, 8.307, 8.611, 8.825, 9.04], "s": 7.022, "e": 9.307}, {"shot": "slipped", "text": "My finger slipped.", "ws": [9.397, 9.558, 9.843], "s": 9.397, "e": 10.174}, {"shot": "textbook", "text": "I turned her whole textbook into reels, 400 pages, 38 reels.", "ws": [10.264, 10.371, 10.585, 10.835, 11.085, 11.442, 11.639, 12.21, 12.532, 13.182, 13.505], "s": 10.264, "e": 13.889}, {"shot": "aiyo", "text": "Aiyooo.", "ws": [13.979], "s": 13.979, "e": 14.595}, {"shot": "onereel2", "text": "She watched one reel. Okay, one reel only.", "ws": [14.685, 14.827, 15.131, 15.345, 15.676, 16.033, 16.229, 16.39], "s": 14.685, "e": 16.747}, {"shot": "quiz", "text": "Then she did the quiz, full marks.", "ws": [16.837, 17.033, 17.158, 17.301, 17.444, 17.747, 17.962], "s": 16.837, "e": 18.346}, {"shot": "spread", "text": "Then her friend watched, then the whole class, then the whole school!", "ws": [18.436, 18.579, 18.775, 19.043, 19.454, 19.597, 19.757, 20.025, 20.525, 20.65, 20.775, 21.043], "s": 18.436, "e": 21.606}, {"shot": "city", "text": "Too late! the whole city is scrolling biology.", "ws": [21.696, 21.839, 22.259, 22.437, 22.759, 23.009, 23.134, 23.455], "s": 21.696, "e": 23.982}]}