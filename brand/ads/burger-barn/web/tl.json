{"dur": 96.18, "lines": [{"shot": "town", "text": "In this town, everybody is out partying.", "ws": [0.282, 0.414, 0.603, 1.141, 1.612, 1.725, 1.933], "s": 0.282, "e": 2.348}, {"shot": "exceptme", "text": "Except me.", "ws": [2.584, 2.999], "s": 2.584, "e": 3.169}, {"shot": "huss1", "text": "HUSS! HUSS! HUSS!", "ws": [3.405, 3.876, 4.329], "s": 3.405, "e": 4.65}, {"shot": "anything", "text": "They will party for anything.", "ws": [4.886, 5.018, 5.207, 5.508, 5.792], "s": 4.886, "e": 6.225}, {"shot": "birthday", "text": "A birthday.", "ws": [6.461, 6.556], "s": 6.461, "e": 6.971}, {"shot": "tuesday", "text": "A Tuesday.", "ws": [7.207, 7.339], "s": 7.207, "e": 7.792}, {"shot": "rock", "text": "Once, somebody found a nice rock.", "ws": [8.027, 8.546, 8.886, 9.093, 9.244, 9.546], "s": 8.027, "e": 9.848}, {"shot": "outthere", "text": "While they are partying all the way out there,", "ws": [10.084, 10.254, 10.348, 10.499, 10.99, 11.159, 11.254, 11.424, 11.631], "s": 10.084, "e": 11.858}, {"shot": "inhere", "text": "I am in here, preparing for a job interview.", "ws": [12.093, 12.244, 12.376, 12.565, 13.037, 13.49, 13.603, 13.735, 13.98], "s": 12.093, "e": 14.376}, {"shot": "huss2", "text": "HUSS! HUSS! HUSS!", "ws": [14.612, 15.065, 15.518], "s": 14.612, "e": 15.858}, {"shot": "barn", "text": "Wrapping burgers. At Burger Barn.", "ws": [16.093, 16.471, 17.122, 17.292, 17.575], "s": 16.093, "e": 17.839}, {"shot": "train", "text": "So I train.", "ws": [18.075, 18.263, 18.376], "s": 18.075, "e": 18.735}, {"shot": "stretch", "text": "Five wrist stretches before breakfast.", "ws": [18.971, 19.216, 19.405, 19.801, 20.103], "s": 18.971, "e": 20.575}, {"shot": "twohundred", "text": "Two hundred wraps before breakfast.", "ws": [20.81, 20.961, 21.282, 21.678, 21.961], "s": 20.81, "e": 22.433}, {"shot": "breakfast", "text": "I do not eat breakfast. I wrap it.", "ws": [22.669, 22.744, 22.839, 23.065, 23.254, 23.961, 24.037, 24.301], "s": 22.669, "e": 24.433}, {"shot": "fold", "text": "Fold. Tuck. Roll.", "ws": [24.669, 25.188, 25.669], "s": 24.669, "e": 25.933}, {"shot": "foursec", "text": "Four seconds. Too slow.", "ws": [26.169, 26.395, 26.99, 27.197], "s": 26.169, "e": 27.442}, {"shot": "huss3", "text": "HUSS! HUSS!", "ws": [27.678, 28.131], "s": 27.678, "e": 28.433}, {"shot": "plate", "text": "I wrapped the plate.", "ws": [28.669, 28.725, 29.046, 29.159], "s": 28.669, "e": 29.461}, {"shot": "cat", "text": "I wrapped my neighbor's cat.", "ws": [29.697, 29.773, 30.056, 30.169, 30.527], "s": 29.697, "e": 30.81}, {"shot": "catfine", "text": "The cat is fine. The cat is warm.", "ws": [31.046, 31.178, 31.348, 31.518, 32.037, 32.169, 32.339, 32.527], "s": 31.046, "e": 32.81}, {"shot": "neighbor", "text": "My neighbor has a party every single night.", "ws": [33.046, 33.197, 33.48, 33.631, 33.725, 34.159, 34.518, 34.839], "s": 33.046, "e": 35.103}, {"shot": "yolo", "text": "Come out, he says. You only live once.", "ws": [35.339, 35.584, 35.829, 35.98, 36.433, 36.584, 36.81, 37.075], "s": 35.339, "e": 37.358}, {"shot": "exactly", "text": "Exactly. One life. One interview.", "ws": [37.593, 38.376, 38.584, 39.065, 39.254], "s": 37.593, "e": 39.669}, {"shot": "huss4", "text": "HUSS! HUSS!", "ws": [39.905, 40.358], "s": 39.905, "e": 40.659}, {"shot": "fold2", "text": "Fold. Tuck. Roll. Two seconds. One second.", "ws": [40.895, 41.292, 41.65, 42.008, 42.197, 42.669, 42.876], "s": 40.895, "e": 43.197}, {"shot": "hands", "text": "I stopped being able to see my own hands.", "ws": [43.433, 43.546, 43.829, 44.056, 44.263, 44.414, 44.584, 44.716, 44.905], "s": 43.433, "e": 45.263}, {"shot": "interview", "text": "Then came the interview.", "ws": [45.499, 45.744, 45.952, 46.065], "s": 45.499, "e": 46.48}, {"shot": "counter", "text": "The manager put one burger on the counter. Whenever you are ready.", "ws": [46.716, 46.81, 47.225, 47.508, 47.678, 47.98, 48.093, 48.188, 48.763, 49.084, 49.178, 49.292], "s": 46.716, "e": 49.499}, {"shot": "already", "text": "It was already wrapped.", "ws": [49.735, 49.81, 49.961, 50.263], "s": 49.735, "e": 50.584}, {"shot": "clipboard", "text": "So was his clipboard. And his tie.", "ws": [50.82, 50.971, 51.084, 51.254, 51.905, 52.056, 52.244], "s": 50.82, "e": 52.527}, {"shot": "impressed", "text": "He was impressed. Then he asked one question.", "ws": [52.763, 52.876, 53.008, 53.716, 53.905, 54.075, 54.395, 54.603], "s": 52.763, "e": 54.979}, {"shot": "cook", "text": "Can you cook a burger?", "ws": [55.215, 55.404, 55.536, 55.705, 55.8], "s": 55.215, "e": 56.064}, {"shot": "never", "text": "I have never cooked a burger. I have never even eaten a burger. I only wrap.", "ws": [56.3, 56.338, 56.583, 56.866, 57.074, 57.168, 57.687, 57.743, 57.875, 58.121, 58.404, 58.687, 58.781, 59.3, 59.357, 59.602], "s": 56.3, "e": 59.942}, {"shot": "nojob", "text": "I did not get the job.", "ws": [60.177, 60.253, 60.385, 60.574, 60.725, 60.857], "s": 60.177, "e": 61.121}, {"shot": "letter", "text": "The letter said: thank you for wrapping my tie.", "ws": [61.357, 61.451, 61.753, 62.177, 62.442, 62.574, 62.668, 62.989, 63.158], "s": 61.357, "e": 63.46}, {"shot": "almost", "text": "Almost.", "ws": [64.404], "s": 64.404, "e": 64.932}, {"shot": "tonight", "text": "So tonight, while they are partying out there, I am back in here, learning to cook.", "ws": [65.168, 65.319, 65.885, 66.055, 66.149, 66.3, 66.677, 66.866, 67.291, 67.536, 67.687, 67.894, 68.083, 68.526, 68.847, 68.998], "s": 65.168, "e": 69.225}, {"shot": "unspool", "text": "I put the whole cookbook into Unspool. Now it is reels and quizzes.", "ws": [69.46, 69.536, 69.725, 69.894, 70.158, 70.592, 70.838, 71.526, 71.885, 71.96, 72.168, 72.47, 72.64], "s": 69.46, "e": 73.036}, {"shot": "fivehundred", "text": "Five hundred burgers before breakfast.", "ws": [73.272, 73.46, 73.725, 74.102, 74.423], "s": 73.272, "e": 74.894}, {"shot": "huss5", "text": "HUSS! HUSS! HUSS!", "ws": [75.13, 75.602, 76.055], "s": 75.13, "e": 76.394}, {"shot": "hired", "text": "You're hired. When can you start?", "ws": [76.63, 76.857, 77.432, 77.564, 77.696, 77.828], "s": 76.63, "e": 78.036}, {"shot": "started", "text": "I already started.", "ws": [78.272, 78.347, 78.668], "s": 78.272, "e": 79.008}, {"shot": "shift", "text": "My first shift was Saturday night. The biggest party of the year.", "ws": [79.243, 79.413, 79.621, 79.904, 80.074, 80.451, 80.913, 81.102, 81.479, 81.743, 81.875, 81.989], "s": 79.243, "e": 82.196}, {"shot": "midnight", "text": "At midnight, the whole town walked in hungry.", "ws": [82.432, 82.602, 83.074, 83.243, 83.526, 83.847, 84.111, 84.281], "s": 82.432, "e": 84.621}, {"shot": "fourhundred", "text": "Four hundred people. One me.", "ws": [84.857, 85.026, 85.328, 85.885, 86.309], "s": 84.857, "e": 86.517}, {"shot": "huss6", "text": "HUSS! HUSS!", "ws": [86.753, 87.215], "s": 86.753, "e": 87.498}, {"shot": "minute", "text": "Four hundred burgers. One minute.", "ws": [87.734, 87.923, 88.206, 88.838, 89.008], "s": 87.734, "e": 89.291}, {"shot": "mayor", "text": "The mayor stared at me. How did you do that?", "ws": [89.526, 89.658, 90.036, 90.3, 90.451, 90.583, 91.111, 91.262, 91.47, 91.677], "s": 89.526, "e": 91.847}, {"shot": "byway", "text": "I said: while you were out partying.", "ws": [92.083, 92.196, 92.621, 92.828, 92.942, 93.074, 93.262], "s": 92.083, "e": 93.64}, {"shot": "huss7", "text": "HUSS!", "ws": [93.875], "s": 93.875, "e": 94.177}]}