{"dur": 93.95, "lines": [{"shot": "town", "text": "In this town, everybody is out partying.", "ws": [0.28, 0.391, 0.613, 1.057, 1.502, 1.631, 1.798], "s": 0.28, "e": 2.169}, {"shot": "exceptme", "text": "Except me.", "ws": [2.372, 2.669], "s": 2.372, "e": 2.817}, {"shot": "huss1", "text": "HUSS! HUSS! HUSS!", "ws": [3.02, 3.465, 3.909], "s": 3.02, "e": 4.243}, {"shot": "anything", "text": "They will party for anything.", "ws": [4.446, 4.594, 4.78, 5.131, 5.409], "s": 4.446, "e": 5.854}, {"shot": "birthday", "text": "A birthday.", "ws": [6.057, 6.15], "s": 6.057, "e": 6.557}, {"shot": "tuesday", "text": "A Tuesday.", "ws": [6.761, 6.872], "s": 6.761, "e": 7.298}, {"shot": "rock", "text": "Once, somebody found a nice rock.", "ws": [7.502, 7.983, 8.298, 8.483, 8.539, 8.798], "s": 7.502, "e": 9.094}, {"shot": "outthere", "text": "While they are partying all the way out there,", "ws": [9.298, 9.465, 9.557, 9.706, 10.206, 10.372, 10.465, 10.631, 10.835], "s": 9.298, "e": 11.02}, {"shot": "inhere", "text": "I am in here, preparing for a job interview.", "ws": [11.224, 11.28, 11.409, 11.613, 12.039, 12.446, 12.557, 12.687, 12.946], "s": 11.224, "e": 13.317}, {"shot": "huss2", "text": "HUSS! HUSS! HUSS!", "ws": [13.52, 13.965, 14.409], "s": 13.52, "e": 14.761}, {"shot": "barn", "text": "Wrapping burgers. At Burger Barn.", "ws": [14.965, 15.354, 15.965, 16.131, 16.428], "s": 14.965, "e": 16.687}, {"shot": "train", "text": "So I train.", "ws": [16.891, 17.298, 17.372], "s": 16.891, "e": 17.687}, {"shot": "stretch", "text": "Five wrist stretches before breakfast.", "ws": [17.891, 18.15, 18.372, 18.743, 19.02], "s": 17.891, "e": 19.465}, {"shot": "twohundred", "text": "Two hundred wraps before breakfast.", "ws": [19.669, 19.798, 20.094, 20.409, 20.687], "s": 19.669, "e": 21.113}, {"shot": "breakfast", "text": "I do not eat breakfast. I wrap it.", "ws": [21.317, 21.391, 21.483, 21.743, 21.946, 22.594, 22.706, 22.965], "s": 21.317, "e": 23.076}, {"shot": "fold", "text": "Fold. Tuck. Roll.", "ws": [23.28, 23.743, 24.169], "s": 23.28, "e": 24.409}, {"shot": "foursec", "text": "Four seconds. Too slow.", "ws": [24.613, 24.854, 25.409, 25.65], "s": 24.613, "e": 25.928}, {"shot": "huss3", "text": "HUSS! HUSS!", "ws": [26.131, 26.594], "s": 26.131, "e": 26.946}, {"shot": "plate", "text": "I wrapped the plate.", "ws": [27.15, 27.224, 27.465, 27.576], "s": 27.15, "e": 27.854}, {"shot": "cat", "text": "I wrapped my neighbor's cat.", "ws": [28.057, 28.113, 28.298, 28.428, 28.798], "s": 28.057, "e": 29.076}, {"shot": "catfine", "text": "The cat is fine. The cat is warm.", "ws": [29.28, 29.372, 29.539, 29.706, 30.187, 30.298, 30.446, 30.631], "s": 29.28, "e": 30.909}, {"shot": "neighbor", "text": "My neighbor has a party every single night.", "ws": [31.113, 31.28, 31.576, 31.706, 31.817, 32.28, 32.669, 33.02], "s": 31.113, "e": 33.261}, {"shot": "yolo", "text": "Come out, he says. You only live once.", "ws": [33.465, 33.687, 33.891, 34.039, 34.483, 34.613, 34.817, 35.094], "s": 33.465, "e": 35.354}, {"shot": "exactly", "text": "Exactly. One life. One interview.", "ws": [35.557, 36.335, 36.502, 36.983, 37.224], "s": 35.557, "e": 37.594}, {"shot": "huss4", "text": "HUSS! HUSS!", "ws": [37.798, 38.261], "s": 37.798, "e": 38.576}, {"shot": "fold2", "text": "Fold. Tuck. Roll. Two seconds. One second.", "ws": [38.78, 39.169, 39.557, 39.928, 40.131, 40.613, 40.835], "s": 38.78, "e": 41.113}, {"shot": "hands", "text": "I stopped being able to see my own hands.", "ws": [41.317, 41.428, 41.687, 41.909, 42.057, 42.206, 42.354, 42.483, 42.669], "s": 41.317, "e": 43.057}, {"shot": "interview", "text": "Then came the interview.", "ws": [43.261, 43.594, 43.798, 43.928], "s": 43.261, "e": 44.317}, {"shot": "counter", "text": "The manager put one burger on the counter. Whenever you are ready.", "ws": [44.52, 44.613, 45.039, 45.335, 45.502, 45.817, 45.909, 46.02, 46.52, 46.854, 46.946, 47.039], "s": 44.52, "e": 47.261}, {"shot": "already", "text": "It was already wrapped.", "ws": [47.465, 47.557, 47.706, 48.057], "s": 47.465, "e": 48.409}, {"shot": "clipboard", "text": "So was his clipboard. And his tie.", "ws": [48.613, 48.743, 48.854, 49.02, 49.669, 49.798, 50.002], "s": 48.613, "e": 50.335}, {"shot": "impressed", "text": "He was impressed. Then he asked one question.", "ws": [50.539, 50.65, 50.78, 51.502, 51.761, 51.965, 52.279, 52.539], "s": 50.539, "e": 52.946}, {"shot": "cook", "text": "Can you cook a burger?", "ws": [53.15, 53.354, 53.483, 53.669, 53.78], "s": 53.15, "e": 54.039}, {"shot": "never", "text": "I have never cooked a burger. I have never even eaten a burger. I only wrap.", "ws": [54.243, 54.28, 54.557, 54.872, 55.076, 55.169, 55.65, 55.706, 55.817, 56.02, 56.317, 56.594, 56.687, 57.169, 57.243, 57.483], "s": 54.243, "e": 57.798}, {"shot": "nojob", "text": "I did not get the job.", "ws": [58.002, 58.057, 58.206, 58.409, 58.539, 58.669], "s": 58.002, "e": 58.946}, {"shot": "letter", "text": "The letter said: thank you for wrapping my tie.", "ws": [59.15, 59.261, 59.539, 59.946, 60.243, 60.409, 60.539, 60.891, 61.113], "s": 59.15, "e": 61.409}, {"shot": "almost", "text": "Almost.", "ws": [62.335], "s": 62.335, "e": 62.835}, {"shot": "tonight", "text": "So tonight, while they are partying out there, I am back in here, learning to cook.", "ws": [63.039, 63.206, 63.743, 63.891, 63.983, 64.131, 64.539, 64.724, 65.169, 65.187, 65.354, 65.557, 65.761, 66.206, 66.483, 66.631], "s": 63.039, "e": 66.872}, {"shot": "unspool", "text": "I put the whole cookbook into Unspool. Now it is reels and quizzes.", "ws": [67.076, 67.094, 67.261, 67.446, 67.724, 68.131, 68.372, 69.094, 69.354, 69.446, 69.65, 69.965, 70.131], "s": 67.076, "e": 70.52}, {"shot": "fivehundred", "text": "Five hundred burgers before breakfast.", "ws": [70.724, 71.076, 71.465, 71.872, 72.187], "s": 70.724, "e": 72.65}, {"shot": "huss5", "text": "HUSS! HUSS! HUSS!", "ws": [72.854, 73.298, 73.743], "s": 72.854, "e": 74.076}, {"shot": "hired", "text": "You are hired. When can you start?", "ws": [74.076, 74.576, 74.687, 75.187, 75.317, 75.428, 75.576], "s": 74.076, "e": 75.817}, {"shot": "started", "text": "I already started.", "ws": [76.02, 76.094, 76.446], "s": 76.02, "e": 76.761}, {"shot": "shift", "text": "My first shift was Saturday night. The biggest party of the year.", "ws": [76.965, 77.131, 77.354, 77.631, 77.817, 78.224, 78.631, 78.872, 79.243, 79.502, 79.613, 79.743], "s": 76.965, "e": 79.965}, {"shot": "midnight", "text": "At midnight, the whole town walked in hungry.", "ws": [80.169, 80.335, 80.854, 81.039, 81.335, 81.65, 81.891, 82.076], "s": 80.169, "e": 82.446}, {"shot": "fourhundred", "text": "Four hundred people. One me.", "ws": [82.65, 82.872, 83.206, 83.724, 83.965], "s": 82.65, "e": 84.169}, {"shot": "huss6", "text": "HUSS! HUSS!", "ws": [84.372, 84.835], "s": 84.372, "e": 85.187}, {"shot": "minute", "text": "Four hundred burgers. One minute.", "ws": [85.391, 85.594, 85.909, 86.502, 86.724], "s": 85.391, "e": 86.983}, {"shot": "mayor", "text": "The mayor stared at me. How did you do that?", "ws": [87.187, 87.335, 87.761, 88.02, 88.15, 88.298, 88.891, 89.057, 89.261, 89.52], "s": 87.187, "e": 89.724}, {"shot": "byway", "text": "I said: while you were out partying.", "ws": [89.928, 90.039, 90.409, 90.631, 90.706, 90.854, 91.02], "s": 89.928, "e": 91.409}, {"shot": "huss7", "text": "HUSS!", "ws": [91.613], "s": 91.613, "e": 91.946}]}