# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://unspool.cc

# ── Supabase (Project Settings → API) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude (plan + scripts + OCR fallback) ────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium

# ── Voiceover: OpenAI TTS (estimated word timing) or ElevenLabs (exact word timing)
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# TTS_PROVIDER=openai   # openai | elevenlabs | none

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: use a Price you created in Stripe instead of inline pricing
# STRIPE_PRICE_SUBSCRIPTION=price_...
# PRICE_DOCUMENT_CENTS=249
# PRICE_SUBSCRIPTION_CENTS=799

# ── Jobs, cron, limits ────────────────────────────────────────────────
# Shared secret for internal generation job calls (defaults to the service role key)
JOB_SECRET=
# Vercel sets this for cron requests: Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# FREE_UPLOADS_PER_DAY=3
# SUBSCRIBER_UPLOADS_PER_DAY=40
# Set to "false" to generate reels 2–10 only after a document is unlocked (cheaper)
# GENERATE_LOCKED_REELS_EAGERLY=true
# IP_HASH_SALT=
